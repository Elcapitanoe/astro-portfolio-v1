---
import Layout from '../layouts/Layout.astro';
import { createT } from '../lib/i18n';
import { DEFAULT_LOCALE, isLocale, normalizeLocale, type Locale } from '../lib/locales';

const segments = Astro.url.pathname.split('/').filter(Boolean);
const potential = segments[0] ?? DEFAULT_LOCALE;
const normalized = normalizeLocale(potential);
const lang: Locale = isLocale(potential) ? potential : normalized;
const t = await createT(lang);
const title = t('error404.title');
const description = t('error404.p');
---

<Layout title={title} description={description} lang={lang}>
  <div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">
    <div class="text-center space-y-8 px-4">
      <div class="space-y-4">
        <h1 class="text-8xl md:text-9xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-400">
          404
        </h1>
        <h2 class="text-2xl md:text-3xl font-semibold text-white">
          {t('error404.h2')}
        </h2>
        <p class="text-lg text-slate-300 max-w-md mx-auto">
          {t('error404.p')}
        </p>
      </div>

      <div class="space-y-4">
        <a
          href={`/${lang}/`}
          class="inline-flex items-center space-x-2 bg-gradient-to-r from-blue-500 to-purple-500 text-white px-8 py-3 rounded-xl font-medium hover:shadow-lg hover:shadow-blue-500/25 transition-all duration-300 hover:scale-105"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          <span>{t('error404.goHome')}</span>
        </a>

        <div class="text-slate-400">
          <p>{t('error404.links')}</p>
          <div class="flex justify-center space-x-4 mt-2">
            <a href={`/${lang}/#about`} class="hover:text-blue-400 transition-colors duration-300">{t('nav.about')}</a>
            <a href={`/${lang}/#skills`} class="hover:text-blue-400 transition-colors duration-300">{t('nav.skills')}</a>
            <a href={`/${lang}/#services`} class="hover:text-blue-400 transition-colors duration-300">{t('nav.services')}</a>
            <a href={`/${lang}/#contact`} class="hover:text-blue-400 transition-colors duration-300">{t('nav.contact')}</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
