---
import Layout from '../layouts/Layout.astro';
import { createT } from '../lib/i18n';
import { DEFAULT_LOCALE, isLocale, normalizeLocale, type Locale } from '../lib/locales';

const segments = Astro.url.pathname.split('/').filter(Boolean);
const potential = segments[0] ?? DEFAULT_LOCALE;
const normalized = normalizeLocale(potential);
const lang: Locale = isLocale(potential) ? potential : normalized;
const t = await createT(lang);
const title = t('error404.title');
const description = t('error404.p');
---

<Layout title={title} description={description} lang={lang}>
  <div class="min-h-[80vh] flex items-center justify-center bg-background">
    <div class="text-center space-y-8 px-4 w-full max-w-xl mx-auto border border-border bg-card rounded-md shadow-sm p-8 relative overflow-hidden">
      <!-- Terminal Header -->
      <div class="absolute top-0 left-0 right-0 h-8 bg-secondary border-b border-border flex items-center px-4 gap-2">
        <div class="w-3 h-3 rounded-full bg-destructive/80"></div>
        <div class="w-3 h-3 rounded-full bg-accent/80"></div>
        <div class="w-3 h-3 rounded-full bg-primary/80"></div>
        <div class="ml-2 text-[10px] font-mono text-muted-foreground uppercase tracking-widest">error.log</div>
      </div>

      <div class="space-y-4 mt-8">
        <h1 class="text-6xl md:text-8xl font-bold font-mono text-primary mt-6">
          404
        </h1>
        <h2 class="text-xl md:text-2xl font-mono text-foreground uppercase tracking-tight font-semibold">
          {t('error404.h2')}
        </h2>
        <p class="text-sm font-mono text-muted-foreground max-w-md mx-auto">
          > {t('error404.p')}
        </p>
      </div>

      <div class="space-y-8 pt-4">
        <a
          href={`/${lang}/`}
          class="inline-flex items-center space-x-2 bg-primary/10 border border-primary text-primary px-6 py-2.5 rounded-md font-mono text-sm hover:bg-primary hover:text-primary-foreground transition-all duration-300"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          <span class="uppercase tracking-widest">{t('error404.goHome')}</span>
        </a>

        <div class="text-muted-foreground font-mono text-xs border-t border-border/50 pt-6 mt-6">
          <p class="mb-3 uppercase tracking-widest text-[10px]">available_routes:</p>
          <div class="flex flex-wrap justify-center gap-4">
            <a href={`/${lang}/#about`} class="hover:text-primary hover:underline underline-offset-4 transition-colors duration-300">./{t('nav.about')}</a>
            <a href={`/${lang}/#skills`} class="hover:text-primary hover:underline underline-offset-4 transition-colors duration-300">./{t('nav.skills')}</a>
            <a href={`/${lang}/#services`} class="hover:text-primary hover:underline underline-offset-4 transition-colors duration-300">./{t('nav.services')}</a>
            <a href={`/${lang}/#contact`} class="hover:text-primary hover:underline underline-offset-4 transition-colors duration-300">./{t('nav.contact')}</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
