---
import { DEFAULT_LOCALE, SUPPORTED_LOCALES } from '../lib/locales';

const supportedLocales = SUPPORTED_LOCALES;
void supportedLocales;
const defaultLocale = DEFAULT_LOCALE;
---

<!DOCTYPE html>
<html lang={defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <title>Redirecting…</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      const SUPPORTED = JSON.parse('{JSON.stringify(supportedLocales.map((locale) => locale.code))}');
      const DEFAULT_LOCALE = JSON.parse('{JSON.stringify(defaultLocale)}');

      const getCookie = (name) => {
        const value = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
        return value ? decodeURIComponent(value[1]) : null;
      };

      const resolveLocale = () => {
        const cookieLocale = getCookie('lang');
        if (cookieLocale && SUPPORTED.includes(cookieLocale)) {
          return cookieLocale;
        }

        const navigatorLocale = (navigator.languages && navigator.languages[0]) || navigator.language || '';
        if (navigatorLocale) {
          const base = navigatorLocale.toLowerCase().split(/[-_]/)[0];
          if (SUPPORTED.includes(base)) {
            return base;
          }
        }

        return DEFAULT_LOCALE;
      };

      const targetLocale = resolveLocale();
      window.location.replace(`/${targetLocale}/`);
    </script>
  </head>
  <body class="min-h-screen bg-slate-900 text-white flex items-center justify-center">
    <p>Redirecting…</p>
  </body>
</html>
