---
import { createT } from '../lib/i18n';
import type { Locale } from '../lib/locales';
import SkillsTabs from './react/SkillsTabs';
import { Cloud, Terminal, Shield, Cpu, Database, Globe, Network, Layers, Activity, Lock, Wifi } from 'lucide-react';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = await createT(lang);

const skillCategories = [
  {
    key: 'infrastructure',
    titleKey: 'skills.categories.infrastructure.title',
    icon: 'cloud',
    skills: [
      { key: 'virtualization', level: 84, icon: 'layers' },
      { key: 'containerOrchestration', level: 85, icon: 'database' },
      { key: 'cloudPlatforms', level: 89, icon: 'globe' },
      { key: 'networkDesign', level: 78, icon: 'network' },
      { key: 'infrastructureAsCode', level: 80, icon: 'cpu' }
    ]
  },
  {
    key: 'systemAdministration',
    titleKey: 'skills.categories.systemAdministration.title',
    icon: 'terminal',
    skills: [
      { key: 'linuxAdministration', level: 82, icon: 'terminal' },
      { key: 'automationScripts', level: 77, icon: 'cpu' },
      { key: 'storageSolutions', level: 86, icon: 'database' },
      { key: 'monitoringLogging', level: 81, icon: 'activity' },
      { key: 'backupRecovery', level: 83, icon: 'database' }
    ]
  },
  {
    key: 'security',
    titleKey: 'skills.categories.security.title',
    icon: 'shield',
    skills: [
      { key: 'networkSecurity', level: 76, icon: 'lock' },
      { key: 'firewallManagement', level: 74, icon: 'shield' },
      { key: 'vpnSetup', level: 88, icon: 'wifi' },
      { key: 'accessControl', level: 82, icon: 'lock' },
      { key: 'sslTlsConfiguration', level: 79, icon: 'shield' }
    ]
  }
];

// Reusing the same mapping in Astro as in React to keep it clean.
const IconMap: Record<string, any> = {
  cloud: Cloud,
  terminal: Terminal,
  shield: Shield,
  layers: Layers,
  database: Database,
  globe: Globe,
  network: Network,
  cpu: Cpu,
  activity: Activity,
  lock: Lock,
  wifi: Wifi,
};

const tabCategories = skillCategories.map((category) => ({
  id: category.key,
  title: t(category.titleKey),
  skills: category.skills.map((skill) => ({
    id: skill.key,
    name: t(`skills.categories.${category.key}.items.${skill.key}`),
    level: skill.level,
    icon: skill.icon,
  })),
}));
---

<section id="skills" class="py-24 bg-background">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-16 max-w-2xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary border border-border text-xs font-mono text-muted-foreground mb-6">
        <span>02 // CAPABILITIES</span>
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-foreground mb-6 tracking-tight">
        {t('skills.h2.1')} <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">{t('skills.h2.2')}</span>
      </h2>
      <p class="text-xl text-muted-foreground font-light">
        {t('skills.lead')}
      </p>
    </div>

    <div class="md:hidden">
      <SkillsTabs
        client:visible
        categories={tabCategories}
        initialCategory={tabCategories[0]?.id}
      />
    </div>

    <div class="hidden md:grid lg:grid-cols-3 gap-8">
      {skillCategories.map((category) => {
        const CategoryIcon = IconMap[category.icon] || Terminal;
        return (
        <div class="bg-card rounded-lg p-8 border border-border hover:border-primary/50 transition-colors shadow-sm">
          <div class="flex items-center space-x-3 mb-8 pb-4 border-b border-border/50">
            <div class="p-2 bg-secondary text-primary rounded-md">
              <CategoryIcon size={20} />
            </div>
            <h3 class="text-lg font-mono font-semibold tracking-tight text-foreground">{t(category.titleKey)}</h3>
          </div>

          <div class="space-y-6">
            {category.skills.map((skill) => {
              const SkillIcon = IconMap[skill.icon] || Terminal;
              const isHigh = skill.level >= 85;
              const barColor = isHigh ? "bg-accent" : "bg-primary";
              return (
              <div class="group">
                <div class="flex items-center justify-between mb-2">
                  <div class="flex items-center space-x-2 text-sm text-muted-foreground group-hover:text-foreground transition-colors">
                    <SkillIcon size={14} />
                    <span>{t(`skills.categories.${category.key}.items.${skill.key}`)}</span>
                  </div>
                  <span class="text-xs font-mono text-muted-foreground">{skill.level}%</span>
                </div>

                <div class="w-full bg-secondary border border-border rounded-sm h-1.5 overflow-hidden">
                  <div class={`h-full ${barColor} rounded-sm`} style={`width: ${skill.level}%;`}></div>
                </div>
              </div>
            )})}
          </div>
        </div>
      )})}
    </div>

    <div class="mt-16 text-center max-w-3xl mx-auto">
      <div class="bg-card rounded-lg p-8 border border-border">
        <h3 class="text-lg font-semibold text-foreground mb-3 font-mono">{t('skills.tail.title')}</h3>
        <p class="text-muted-foreground leading-relaxed">
          {t('skills.tail.body')}
        </p>
      </div>
    </div>
  </div>
</section>
