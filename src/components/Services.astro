---
import { createT } from '../lib/i18n';
import type { Locale } from '../lib/locales';
import { Server, Cloud, Shield, Settings, Monitor, Database, ArrowRight } from 'lucide-react';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = await createT(lang);

const services = [
  { key: 'homelab', icon: Server, featureKeys: ['1', '2', '3', '4', '5'] },
  { key: 'cloud', icon: Cloud, featureKeys: ['1', '2', '3', '4', '5'] },
  { key: 'security', icon: Shield, featureKeys: ['1', '2', '3', '4', '5'] },
  { key: 'automation', icon: Settings, featureKeys: ['1', '2', '3', '4', '5'] },
  { key: 'monitoring', icon: Monitor, featureKeys: ['1', '2', '3', '4', '5'] },
  { key: 'data', icon: Database, featureKeys: ['1', '2', '3', '4', '5'] }
];
---

<section id="services" class="py-24 bg-muted/30 border-y border-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-16 max-w-2xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary border border-border text-xs font-mono text-muted-foreground mb-6">
        <span>03 // SERVICES</span>
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-foreground mb-6 tracking-tight">
        {t('services.h2.1')} <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">{t('services.h2.2')}</span>
      </h2>
      <p class="text-xl text-muted-foreground font-light">
        {t('services.lead')}
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((service) => {
        const Icon = service.icon;
        return (
        <div class="group bg-card rounded-lg p-8 border border-border hover:border-primary/50 transition-colors shadow-sm relative overflow-hidden flex flex-col h-full">
          <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
            <Icon size={120} strokeWidth={1} />
          </div>

          <div class="mb-6 relative z-10">
            <div class="inline-flex p-3 rounded-md bg-secondary text-primary group-hover:bg-primary/10 group-hover:text-accent transition-colors">
              <Icon size={24} />
            </div>
          </div>

          <h3 class="text-xl font-mono font-semibold text-foreground mb-3 tracking-tight group-hover:text-primary transition-colors relative z-10">{t(`services.cards.${service.key}.title`)}</h3>
          <p class="text-muted-foreground mb-8 leading-relaxed relative z-10 flex-grow">{t(`services.cards.${service.key}.description`)}</p>

          <div class="pt-6 border-t border-border/50 mt-auto relative z-10">
            <h4 class="text-xs font-mono text-muted-foreground mb-4 uppercase tracking-wider">Features included</h4>
            <ul class="space-y-3">
              {service.featureKeys.map((featureKey) => (
                <li class="flex items-start space-x-3 text-sm text-foreground/80">
                  <div class="w-1.5 h-1.5 bg-primary/60 rounded-full mt-1.5 group-hover:bg-accent transition-colors"></div>
                  <span>{t(`services.cards.${service.key}.features.${featureKey}`)}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )})}
    </div>

    <div class="mt-20">
      <div class="bg-card rounded-lg border border-border overflow-hidden flex flex-col md:flex-row md:items-center">
        <div class="p-8 md:p-12 flex-1">
          <h3 class="text-2xl font-bold text-foreground mb-4 tracking-tight">{t('services.tail.title')}</h3>
          <p class="text-muted-foreground text-lg mb-8 max-w-xl">
            {t('services.tail.body')}
          </p>
          <a href="#contact" class="inline-flex items-center gap-2 bg-primary text-primary-foreground hover:bg-primary/90 px-6 py-3 rounded-md font-medium transition-colors">
            <span>{t('services.tail.cta')}</span>
            <ArrowRight size={18} />
          </a>
        </div>
        <div class="hidden md:flex flex-1 bg-muted/50 border-l border-border h-full items-center justify-center p-12 min-h-[300px] relative overflow-hidden">
            <div class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_center,theme(colors.primary.DEFAULT)_1px,transparent_1px)] bg-[size:20px_20px]"></div>
            <Server size={100} className="text-muted-foreground opacity-50 relative z-10" strokeWidth={1} />
        </div>
      </div>
    </div>
  </div>
</section>
