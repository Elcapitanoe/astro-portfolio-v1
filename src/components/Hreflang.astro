---
import { DEFAULT_LOCALE, SUPPORTED_LOCALES } from '../lib/locales';

interface Props {
  path: string;
}

const { path } = Astro.props;
const normalizedPath = path.startsWith('/') ? path : `/${path}`;
---

{SUPPORTED_LOCALES.map((locale) => (
  <link rel="alternate" hreflang={locale.code} href={`/${locale.code}${normalizedPath}`} />
))}
<link rel="alternate" hreflang="x-default" href={`/${DEFAULT_LOCALE}${normalizedPath}`} />
