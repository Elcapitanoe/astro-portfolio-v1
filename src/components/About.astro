---
import { createT } from '../lib/i18n';
import type { Locale } from '../lib/locales';
import { Code2, Server, Zap, Heart, CheckCircle2 } from 'lucide-react';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = await createT(lang);

const highlights = [
  { icon: Code2, key: 'innovation' },
  { icon: Server, key: 'homelab' },
  { icon: Zap, key: 'automation' },
  { icon: Heart, key: 'sharing' }
];

const bulletKeys = ['1', '2', '3', '4'];
---

<section id="about" class="py-24 bg-muted/30 border-y border-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-16 max-w-2xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary border border-border text-xs font-mono text-muted-foreground mb-6">
        <span>01 // PROFILE</span>
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-foreground mb-6 tracking-tight">
        {t('about.h2.1')} <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">{t('about.h2.2')}</span>
      </h2>
      <p class="text-xl text-muted-foreground font-light leading-relaxed">
        {t('about.lead')}
      </p>
    </div>

    <div class="grid lg:grid-cols-5 gap-12 items-start mb-20">
      <div class="lg:col-span-3 space-y-6 text-muted-foreground leading-relaxed text-lg">
        <p>
          {t('about.p1')}
        </p>
        <p>
          {t('about.p2')}
        </p>
        <p>
          {t('about.p3')}
        </p>
      </div>

      <div class="lg:col-span-2 relative">
        <div class="bg-card p-8 rounded-lg border border-border shadow-sm">
          <h3 class="text-sm font-mono text-primary mb-6 flex items-center gap-2">
            <Server size={16} />
            <span>sys_summary</span>
          </h3>
          <ul class="space-y-4 text-muted-foreground">
            {bulletKeys.map((key) => (
              <li class="flex items-start gap-3">
                <CheckCircle2 size={18} className="text-accent mt-0.5 shrink-0" />
                <span class="text-sm">{t(`about.bullets.${key}`)}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {highlights.map((highlight) => {
        const Icon = highlight.icon;
        return (
          <div class="bg-card p-6 rounded-lg border border-border hover:border-primary/50 transition-colors group">
            <div class="mb-5 inline-flex p-3 rounded-md bg-secondary text-primary group-hover:bg-primary/10 group-hover:text-accent transition-colors">
              <Icon size={24} strokeWidth={1.5} />
            </div>
            <h3 class="text-lg font-semibold text-foreground mb-2 font-mono tracking-tight group-hover:text-primary transition-colors">
              {t(`about.highlights.${highlight.key}.title`)}
            </h3>
            <p class="text-muted-foreground text-sm leading-relaxed">
              {t(`about.highlights.${highlight.key}.description`)}
            </p>
          </div>
        );
      })}
    </div>
  </div>
</section>
