---
import { createT } from '../lib/i18n';
import { SUPPORTED_LOCALES, type Locale } from '../lib/locales';
import LanguageSwitcherDropdown from './react/LanguageSwitcherDropdown';

interface Props {
  lang: Locale;
  class?: string;
}

const { lang, class: className = '' } = Astro.props;
const t = await createT(lang);
const { pathname, hash } = Astro.url;

const locales = SUPPORTED_LOCALES.map((locale) => {
  const normalizedPath = pathname.replace(/^\/[a-z]{2}(?:-[A-Z]{2})?\//, '/');
  const hrefPath = `/${locale.code}${normalizedPath}`.replace(/\/{2,}/g, '/');
  const href = hash ? `${hrefPath}${hash}` : hrefPath;
  return {
    code: locale.code,
    name: locale.name,
    href,
    active: locale.code === lang,
  };
});

const menuLabel = t('nav.language');
const selectLabel = t('nav.languageSelected');
---

<div class:list={['inline-flex', 'w-full', 'justify-start', 'md:w-auto', className]}>
  <LanguageSwitcherDropdown
    client:idle
    locales={locales}
    menuLabel={menuLabel}
    selectLabel={selectLabel}
  />
</div>
