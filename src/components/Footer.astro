---
import { createT } from '../lib/i18n';
import type { Locale } from '../lib/locales';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = await createT(lang);
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-900 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0">
      <div class="text-sm text-slate-400">
        © {currentYear} Domi Adiwijaya. {t('footer.rights')}
      </div>
      <div class="flex items-center space-x-4 text-sm text-slate-400">
        <span>{t('footer.engineered')}</span>
        <div class="flex items-center space-x-3">
          <span class="flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-[#FF5D01]"></span>
            <span>Astro</span>
          </span>
          <span class="flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-[#06B6D4]"></span>
            <span>TailwindCSS</span>
          </span>
          <span class="flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-[#46A758]"></span>
            <span>Radix UI</span>
          </span>
          <span class="flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-black"></span>
            <span>shadcn/ui</span>
          </span>
        </div>
      </div>
    </div>
  </div>
</footer>
