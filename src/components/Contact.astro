---
import { createT } from '../lib/i18n';
import type { Locale } from '../lib/locales';
import ContactActions from './react/ContactActions';
import { Mail, MapPin, Clock, Terminal } from 'lucide-react';
// We'll use custom SVG for social links to avoid deprecation warnings from lucide-react in Astro


interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = await createT(lang);

const contactInfo = [
  {
    icon: Mail,
    title: t('contact.info.email.title'),
    content: t('contact.info.email.value'),
    href: `mailto:${t('contact.info.email.value')}`
  },
  {
    icon: MapPin,
    title: t('contact.info.location.title'),
    content: t('contact.info.location.value'),
    href: null
  },
  {
    icon: Clock,
    title: t('contact.info.response.title'),
    content: t('contact.info.response.value'),
    href: null
  }
];

const socialLinks = [
  { href: 'https://github.com/elcapitanoe', icon: 'github', label: t('contact.social.github') },
  { href: 'https://www.linkedin.com/in/domiadiwijaya', icon: 'linkedin', label: t('contact.social.linkedin') }
];

const getSocialIcon = (iconName: string) => {
  if (iconName === 'github') return 'M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z';
  if (iconName === 'linkedin') return 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';
  return '';
};
---

<section id="contact" class="py-24 bg-background">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-16 max-w-2xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary border border-border text-xs font-mono text-muted-foreground mb-6">
        <span>04 // CONTACT</span>
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-foreground mb-6 tracking-tight">
        {t('contact.h2.1')} <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">{t('contact.h2.2')}</span>
      </h2>
      <p class="text-xl text-muted-foreground font-light leading-relaxed">
        {t('contact.lead')}
      </p>
    </div>

    <div class="grid lg:grid-cols-5 gap-12">
      <div class="lg:col-span-3 space-y-8">
        <div class="bg-card border border-border rounded-lg overflow-hidden shadow-sm">
          <div class="px-6 py-4 border-b border-border bg-muted/30 flex items-center gap-3">
            <Terminal size={18} className="text-primary" />
            <h3 class="text-sm font-mono font-semibold text-foreground tracking-tight">new_ticket.sh</h3>
          </div>
          
          <div class="p-6 md:p-8">
            <p class="text-muted-foreground mb-8 text-sm leading-relaxed">
              {t('contact.drop.body')}
            </p>

            <form id="contact-form" class="space-y-5 font-mono text-sm">
              <div class="grid md:grid-cols-2 gap-5">
                <div class="space-y-2">
                  <label for="name" class="block text-xs font-medium text-muted-foreground uppercase tracking-wider">{t('contact.form.name_label')}</label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    autocomplete="name"
                    class="w-full px-4 py-2.5 bg-secondary/50 border border-border rounded-md text-foreground placeholder:text-muted-foreground/50 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors"
                    placeholder={t('contact.form.name_ph')}
                  />
                </div>
                <div class="space-y-2">
                  <label for="email" class="block text-xs font-medium text-muted-foreground uppercase tracking-wider">{t('contact.form.email_label')}</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    autocomplete="email"
                    class="w-full px-4 py-2.5 bg-secondary/50 border border-border rounded-md text-foreground placeholder:text-muted-foreground/50 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors"
                    placeholder={t('contact.form.email_ph')}
                  />
                </div>
              </div>

              <div class="space-y-2">
                <label for="subject" class="block text-xs font-medium text-muted-foreground uppercase tracking-wider">{t('contact.form.subject_label')}</label>
                <input
                  type="text"
                  id="subject"
                  name="subject"
                  autocomplete="off"
                  class="w-full px-4 py-2.5 bg-secondary/50 border border-border rounded-md text-foreground placeholder:text-muted-foreground/50 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors"
                  placeholder={t('contact.form.subject_ph')}
                />
              </div>

              <div class="space-y-2">
                <label for="message" class="block text-xs font-medium text-muted-foreground uppercase tracking-wider">{t('contact.form.message_label')}</label>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows="5"
                  class="w-full px-4 py-3 bg-secondary/50 border border-border rounded-md text-foreground placeholder:text-muted-foreground/50 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors resize-none"
                  placeholder={t('contact.form.message_ph')}
                ></textarea>
              </div>

              <ContactActions
                client:visible
                email={t('contact.info.email.value')}
                copyLabel={t('contact.actions.copyEmail')}
                copiedLabel={t('contact.actions.emailCopied')}
                popoverTitle={t('contact.info.response.title')}
                popoverDescription={t('contact.info.response.value')}
                sendLabel={t('contact.actions.openEmail')}
                mailtoHref={`mailto:${t('contact.info.email.value')}`}
              />
            </form>
          </div>
        </div>
      </div>

      <div class="lg:col-span-2 space-y-8">
        <div>
          <h3 class="text-xl font-bold text-foreground mb-4 tracking-tight">{t('contact.connect.title')}</h3>
          <p class="text-muted-foreground leading-relaxed text-sm mb-6">
            {t('contact.connect.body')}
          </p>
        </div>

        <div class="space-y-4">
          {contactInfo.map((info) => {
            const Icon = info.icon;
            return (
            <div class="bg-card rounded-lg p-5 border border-border hover:border-primary/50 transition-colors flex items-start gap-4">
              <div class="p-2.5 bg-secondary text-primary rounded-md shrink-0">
                <Icon size={18} />
              </div>
              <div>
                <h4 class="text-foreground font-medium text-sm mb-1">{info.title}</h4>
                {info.href ? (
                  <a href={info.href} class="text-muted-foreground text-sm hover:text-primary transition-colors">{info.content}</a>
                ) : (
                  <p class="text-muted-foreground text-sm">{info.content}</p>
                )}
              </div>
            </div>
          )})}
        </div>

        <div class="pt-6 border-t border-border/50">
          <h4 class="text-foreground font-mono text-sm tracking-tight mb-4">{t('contact.connect.findMe')}</h4>
          <div class="flex gap-4">
            {socialLinks.map((link) => {
              return (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="p-3 bg-card border border-border rounded-md hover:border-primary hover:bg-secondary/50 group transition-all"
                aria-label={link.label}
              >
                <svg viewBox="0 0 24 24" class="w-5 h-5 text-muted-foreground group-hover:text-primary transition-colors fill-current">
                  <path d={getSocialIcon(link.icon)}></path>
                </svg>
              </a>
            )})}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>