---
import { createT } from '../lib/i18n';
import { SUPPORTED_LOCALES, type Locale } from '../lib/locales';
import LanguageSwitcher from './LanguageSwitcher.astro';
import MobileNavMenu from './react/MobileNavMenu';
import { Terminal } from 'lucide-react';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = await createT(lang);

const navItems = [
  { href: '#home', label: t('nav.home') },
  { href: '#about', label: t('nav.about') },
  { href: '#skills', label: t('nav.skills') },
  { href: '#services', label: t('nav.services') },
  { href: '#contact', label: t('nav.contact') }
];

const menuLabel = t('nav.openMenu');
const closeLabel = t('nav.closeMenu');

const { pathname, hash } = Astro.url;
const localeOptions = SUPPORTED_LOCALES.map((locale) => {
  const normalizedPath = pathname.replace(/^\/[a-z]{2}(?:-[A-Z]{2})?\//, '/');
  const hrefPath = `/${locale.code}${normalizedPath}`.replace(/\/{2,}/g, '/');
  const href = hash ? `${hrefPath}${hash}` : hrefPath;
  return {
    code: locale.code,
    name: locale.name,
    href,
    active: locale.code === lang,
  };
});
---

<header
  class="fixed top-0 left-0 right-0 z-50 border-b border-border bg-background/80 backdrop-blur-md supports-[backdrop-filter]:bg-background/60"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14">
      <a href="#home" class="flex items-center gap-2 group">
        <div class="p-1.5 rounded-md bg-secondary border border-border group-hover:border-primary/50 transition-colors">
          <Terminal size={18} className="text-primary" />
        </div>
        <span class="text-sm font-mono font-semibold tracking-tight text-foreground">DOMI</span>
      </a>

      <nav class="hidden md:flex items-center space-x-6" aria-label="Primary navigation">
        <div class="ml-10 flex items-center space-x-6">
          {navItems.map((item) => (
            <a
              href={item.href}
              class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground relative group py-2"
            >
              {item.label}
              <span class="absolute inset-x-0 bottom-0 h-0.5 bg-primary origin-left scale-x-0 transition-transform group-hover:scale-x-100 ease-out duration-300"></span>
            </a>
          ))}
        </div>
        <div class="h-4 w-px bg-border"></div>
        <LanguageSwitcher lang={lang} />
      </nav>

      <div class="md:hidden flex items-center gap-2">
        <LanguageSwitcher lang={lang} />
        <MobileNavMenu
          client:idle
          navItems={navItems}
          locales={localeOptions}
          menuLabel={menuLabel}
          closeLabel={closeLabel}
          selectLabel={t('nav.languageSelected')}
        />
      </div>
    </div>
  </div>
</header>
