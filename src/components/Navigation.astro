---
import { createT } from '../lib/i18n';
import { SUPPORTED_LOCALES, type Locale } from '../lib/locales';
import LanguageSwitcher from './LanguageSwitcher.astro';
import MobileNavMenu from './react/MobileNavMenu';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = await createT(lang);

const navItems = [
  { href: '#home', label: t('nav.home') },
  { href: '#about', label: t('nav.about') },
  { href: '#skills', label: t('nav.skills') },
  { href: '#services', label: t('nav.services') },
  { href: '#contact', label: t('nav.contact') }
];

const menuLabel = t('nav.openMenu');
const closeLabel = t('nav.closeMenu');

const { pathname, hash } = Astro.url;
const localeOptions = SUPPORTED_LOCALES.map((locale) => {
  const normalizedPath = pathname.replace(/^\/[a-z]{2}(?:-[A-Z]{2})?\//, '/');
  const hrefPath = `/${locale.code}${normalizedPath}`.replace(/\/{2,}/g, '/');
  const href = hash ? `${hrefPath}${hash}` : hrefPath;
  return {
    code: locale.code,
    name: locale.name,
    href,
    active: locale.code === lang,
  };
});
---

<header
  class="fixed top-0 left-0 right-0 z-50 border-b border-white/5 bg-slate-950/70 backdrop-blur-lg"
  transition:persist="site-nav"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <div class="flex items-center gap-3">
        <span class="text-xl font-bold text-white">DA</span>
      </div>

      <nav class="hidden md:flex items-center space-x-6" aria-label="Primary navigation">
        <div class="ml-10 flex items-baseline space-x-4">
          {navItems.map((item) => (
            <a
              href={item.href}
              class="text-sm font-medium text-muted-foreground transition hover:text-white"
            >
              {item.label}
            </a>
          ))}
        </div>
        <LanguageSwitcher lang={lang} />
      </nav>

      <div class="md:hidden">
        <MobileNavMenu
          client:idle
          navItems={navItems}
          locales={localeOptions}
          menuLabel={menuLabel}
          closeLabel={closeLabel}
          selectLabel={t('nav.languageSelected')}
        />
      </div>
    </div>
  </div>
</header>
