---
import { createT } from '../lib/i18n';
import { buildLocaleOptions } from '../lib/locale-options';
import type { Locale } from '../lib/locales';
import LanguageSelector from './LanguageSelector.astro';
import MobileNavMenu from './react/MobileNavMenu';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = await createT(lang);

const navItems = [
  { href: '#home', label: t('nav.home') },
  { href: '#about', label: t('nav.about') },
  { href: '#skills', label: t('nav.skills') },
  { href: '#services', label: t('nav.services') },
  { href: '#contact', label: t('nav.contact') },
];

const menuLabel = t('nav.openMenu');
const closeLabel = t('nav.closeMenu');

const { pathname, hash } = Astro.url;
const localeOptions = buildLocaleOptions({ lang, pathname, hash });
---

<header
  class="fixed left-0 right-0 top-0 z-50 border-b border-white/5 bg-slate-950/70 backdrop-blur-lg"
  transition:persist="site-nav"
>
  <div class="mx-auto flex h-16 w-full max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-3">
      <span class="text-xl font-bold text-white">DA</span>
    </div>

    <nav class="hidden items-center space-x-6 md:flex" aria-label="Primary navigation">
      <div class="ml-10 flex items-baseline space-x-4">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-muted-foreground transition hover:text-white"
          >
            {item.label}
          </a>
        ))}
      </div>
      <LanguageSelector lang={lang} locales={localeOptions} class="md:ml-6" />
    </nav>

    <div class="md:hidden">
      <MobileNavMenu
        client:idle
        navItems={navItems}
        locales={localeOptions}
        menuLabel={menuLabel}
        closeLabel={closeLabel}
        selectLabel={t('nav.languageSelected')}
      />
    </div>
  </div>
</header>
