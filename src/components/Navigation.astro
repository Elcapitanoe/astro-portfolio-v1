---
import MobileNavMenu from './react/MobileNavMenu';

const navItems = [
  { href: '#home', label: 'Home' },
  { href: '#about', label: 'About' },
  { href: '#skills', label: 'Expertise' },
  { href: '#services', label: 'Services' },
  { href: '#contact', label: 'Contact' },
];

const menuLabel = 'Open navigation menu';
const closeLabel = 'Close navigation menu';
const menuDescription = 'Choose a section to explore.';
---

<header
  class="fixed left-0 right-0 top-0 z-50 border-b border-white/5 bg-slate-950/70 backdrop-blur-lg"
  transition:persist="site-nav"
>
  <div class="mx-auto flex h-16 w-full max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-3">
      <span class="text-xl font-bold text-white">DA</span>
    </div>

    <nav class="hidden items-center space-x-6 md:flex" aria-label="Primary navigation">
      <div class="ml-10 flex items-baseline space-x-4">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-muted-foreground transition hover:text-white"
          >
            {item.label}
          </a>
        ))}
      </div>
    </nav>

    <div class="md:hidden">
      <MobileNavMenu
        client:idle
        navItems={navItems}
        menuLabel={menuLabel}
        closeLabel={closeLabel}
        description={menuDescription}
      />
    </div>
  </div>
</header>
